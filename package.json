{
  "name": "cotizacion-plataforma-aprendizaje",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cotización comercial para una plataforma educativa personalizada.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "build:js": "esbuild ./src/app.js --bundle --minify --format=iife --outfile=./public/app.js",
    "build": "npm run build:css && npm run build:js",
    "start": "node server.js",
    "check": "npm run build && node scripts/check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.3.3"
  }
}
